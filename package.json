{
  "name": "gtsn-ai",
  "private": true,
  "version": "1.0.1",
  "main": "electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "vite build --base=/ && node copy-video.js",
    "build:check": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "electron": "electron .",
    "electron:dev": "cross-env NODE_ENV=production electron .",
    "electron:dev:local": "concurrently \"npm run dev\" \"wait-on http://localhost:5174 && cross-env NODE_ENV=development electron .\"",
    "electron:build": "npm run build:python && npm run build && electron-builder",
    "electron:build:win": "npm run build:python && npm run build && electron-builder --win",
    "electron:build:mac": "npm run build:python && npm run build && electron-builder --mac",
    "electron:build:linux": "npm run build:python && npm run build && electron-builder --linux",
    "build:python": "python -m PyInstaller --onefile --noconsole --add-data \"bin/libGFEngine2D.dll;.\" --add-data \"bin/tensorflow.dll;.\" --add-data \"bin/libgcc_s_seh-1.dll;.\" --add-data \"bin/libstdc++-6.dll;.\" --add-data \"bin/libwinpthread-1.dll;.\" --hidden-import=ctypes --hidden-import=json --hidden-import=sys --hidden-import=PIL --hidden-import=PIL.Image --distpath dist-python --workpath build-python --clean bin/gfengine-server-srcimages.py",
    "test:standalone": "test-standalone-exe.bat",
    "build:all": "npm run electron:build:win"
  },
  "build": {
    "appId": "com.gtsn.golfai",
    "productName": "GTSN Golf AI",
    "directories": {
      "buildResources": "resources",
      "output": "dist-electron"
    },
    "publish": {
      "provider": "generic",
      "url": "https://ai.playgts.com/updates/"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "lib/**/*",
      "bin/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "public/icon.ico"
    },
    "nsis": {
      "artifactName": "GTSAI_Setup.${ext}"
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "icon": "public/icon.icns"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "icon": "public/icon.png"
    },
    "extraResources": [
      {
        "from": "dist-python/gfengine-server-srcimages.exe",
        "to": "bin/gfengine-server-srcimages.exe",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "bin/libGFEngine2D.dll",
        "to": "bin/libGFEngine2D.dll"
      },
      {
        "from": "bin/tensorflow.dll",
        "to": "bin/tensorflow.dll"
      },
      {
        "from": "bin/libgcc_s_seh-1.dll",
        "to": "bin/libgcc_s_seh-1.dll"
      },
      {
        "from": "bin/libstdc++-6.dll",
        "to": "bin/libstdc++-6.dll"
      },
      {
        "from": "bin/libwinpthread-1.dll",
        "to": "bin/libwinpthread-1.dll"
      },
      {
        "from": "node_modules/@ffmpeg-installer/win32-x64/ffmpeg.exe",
        "to": "ffmpeg/ffmpeg.exe"
      },
      {
        "from": "node_modules/@ffprobe-installer/win32-x64/ffprobe.exe",
        "to": "ffmpeg/ffprobe.exe"
      }
    ]
  },
  "dependencies": {
    "@ffmpeg-installer/ffmpeg": "^1.1.0",
    "@ffprobe-installer/ffprobe": "^2.1.2",
    "@headlessui/react": "^2.2.9",
    "@heroicons/react": "^2.2.0",
    "electron-log": "^5.4.3",
    "electron-updater": "^6.7.3",
    "fluent-ffmpeg": "^2.1.3",
    "i18next": "^25.7.3",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-i18next": "^16.5.0",
    "react-is": "^19.2.3",
    "react-router-dom": "^7.10.1",
    "recharts": "^3.6.0",
    "swiper": "^12.0.3",
    "zustand": "^5.0.9"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@tailwindcss/postcss": "^4.1.17",
    "@types/fluent-ffmpeg": "^2.1.27",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "autoprefixer": "^10.4.22",
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "electron": "^39.2.7",
    "electron-builder": "^26.4.0",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "js-yaml": "^4.1.1",
    "postcss": "^8.5.6",
    "tailwindcss": "^4.1.17",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.4",
    "vite": "^7.2.4",
    "vite-plugin-pages": "^0.33.2",
    "wait-on": "^9.0.3"
  }
}
